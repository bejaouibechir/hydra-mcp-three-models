# Copy to .env and fill in the keys you have. A model without a key is skipped.
# The keys stay on your machine: .env is ignored by git.

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com

ZAI_API_KEY=
GLM_MODEL=glm-5.2
GLM_BASE_URL=https://api.z.ai/api/paas/v4/
